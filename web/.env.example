# Copy to .env. Variables are declared in src/env.ts; all three are public and inlined at build time.
API_URL=http://localhost:8000
TILES_URL=http://localhost:3000
# Any MapLibre style JSON. OpenFreeMap Positron needs no key. For OS NGD tiles, use the style URL
# from your OS Data Hub project (light-3857 or blackwhite-3857) including ?key=...
BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
