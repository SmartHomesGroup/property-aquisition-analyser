# Copy to .env. All settings are prefixed PAA_.
PAA_DATABASE_URL=postgresql://paa:paa@localhost:5432/paa
PAA_DATA_DIR=../data
# Restrict loads to postcode areas while prototyping (comma-separated), e.g. EN,N
PAA_POSTCODE_AREAS=
PAA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The stage-0 analysis engine (n8n -> Claude). Empty disables the paste-a-listing flow.
PAA_LISTING_WEBHOOK_URL=https://dwilson92.app.n8n.cloud/webhook/property-analyser
